# Local Postgres (started via `pnpm db:up` — see db/docker-compose.yml).
# The worker connects directly; the dashboard uses this server-side only
# (it's never inlined into the browser bundle) and exposes a LISTEN/NOTIFY
# bridge to the browser via /api/stream.
DATABASE_URL=postgres://symphony:symphony@127.0.0.1:54422/symphony

# Linear API
LINEAR_API_KEY=

# Worker
WORKFLOW_PATH=./WORKFLOW.md
LOG_LEVEL=info

# Target Linear team / project. Read by WORKFLOW.md via ${VAR} interpolation,
# so retargeting at a new team is an .env.local edit (no WORKFLOW.md change).
SYMPHONY_LINEAR_WORKSPACE=         # workspace slug — linear.app/<slug>/... ; enables dashboard "linear ↗" links
SYMPHONY_TRACKER_PREFIX=           # issue-identifier prefix (e.g. PB-); leave blank if the API key sees only one team
SYMPHONY_TRACKER_PROJECT_ID=       # Linear project UUID(s) to restrict the worker to; comma-separated for multiple (e.g. uuid1,uuid2); blank = no project filter
SYMPHONY_MAX_CONCURRENT_AGENTS=    # positive integer cap on concurrent agents; blank → 4
SYMPHONY_AGENT_BACKEND=            # one of claude or codex; defaults to claude when unset

# Multi-repo: target repos and their install commands live in ./repos.md (one
# entry per target — repos.md is required; the worker exits at startup if it's
# missing). Issues route by `repo:<name>` Linear label. Per-repo env (e.g.
# app session cookies) is wired through the entry's `env:` block, which can
# interpolate ${VAR} from this file. See repos.md.example for the schema.
